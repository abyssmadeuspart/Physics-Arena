{
  "schema_version": 2,
  "engine_id": "nvidia_physx34",
  "source": {
    "type": "versioned",
    "repository_url": "https://github.com/NVIDIAGameWorks/PhysX-3.4",
    "revision": "3.4.2",
    "reference_child": "PhysX-3.4"
  },
  "prepare": {
    "prepared_path": ".generated/engines/nvidia_physx34",
    "overlays": [
      {
        "source": "src/nvidia_physx34/cases",
        "target": "cases"
      }
    ]
  },
  "build": {
    "route": "nvidia_physx34_optimized_release",
    "runner_source_dir": "src/nvidia_physx34/bench",
    "runner_build_dir_windows": ".build/nvidia_physx34/runner/windows-release",
    "package_dir_windows": "release/windows-x64/nvidia-physx-3.4",
    "target": "nvidia_physx34_polygon_runner",
    "toolchain_id_windows": "nvidia_physx34_optimized_release",
    "sdk_solution": "PhysX_3.4/Source/compiler/vc15win64/PhysX.sln",
    "sdk_bin_dir": "PhysX_3.4/Bin/vc15win64",
    "sdk_lib_dir": "PhysX_3.4/Lib/vc15win64",
    "sdk_pxshared_bin_dir": "PxShared/bin/vc15win64",
    "sdk_pxshared_lib_dir": "PxShared/lib/vc15win64",
    "sdk_configuration": "release",
    "sdk_platform": "x64",
    "runtime_dlls": [
      "PhysX3_x64.dll",
      "PhysX3Common_x64.dll",
      "PhysX3Cooking_x64.dll",
      "PxFoundation_x64.dll",
      "PxPvdSDK_x64.dll"
    ],
    "required_import_libs": [
      "PhysX3_x64.lib",
      "PhysX3Common_x64.lib",
      "PhysX3Cooking_x64.lib",
      "PhysX3Extensions.lib",
      "PxFoundation_x64.lib",
      "PxPvdSDK_x64.lib",
      "PxTask_x64.lib",
      "PsFastXml_x64.lib"
    ],
    "executable_names": [
      "nvidia_physx34_polygon_runner.exe"
    ],
    "executable_name_windows": "nvidia_physx34_polygon_runner.exe"
  },
  "report_metadata": {
    "physics_settings": "position_iterations=5; velocity_iterations=1; sleep_threshold=0",
    "build_settings": "Visual Studio 2026 MSBuild Release; NVIDIA PhysX 3.4 SDK+runner",
    "report_version": "3.4.2"
  },
  "native_settings": {
    "solver": {
      "position_iterations": {
        "native_name": "setSolverIterationCounts minPositionIters",
        "minimum": 1,
        "maximum": 255,
        "authored_default": 5
      },
      "velocity_iterations": {
        "native_name": "setSolverIterationCounts minVelocityIters",
        "minimum": 1,
        "maximum": 255,
        "authored_default": 1
      }
    },
    "sleep_enabled_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "sleep_disabled_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "continuous_collision_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "maximum_restitution": 1.0,
    "ragdoll_damping_mode": "native_coefficient",
    "continuous_collision_semantics": "discrete_swept_ccd"
  }
}
