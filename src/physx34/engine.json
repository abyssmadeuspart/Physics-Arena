{
  "schema_version": 2,
  "engine_id": "physx34",
  "source": {
    "type": "git",
    "repository_url": "git@github.com:GapingPixel/UnrealEngineVite-PhysX.git",
    "revision": "2b13cae09734616d07d09ecf645326fa0bf43ef7",
    "reference_child": "UnrealEngineVite-PhysX"
  },
  "prepare": {
    "prepared_path": ".generated/engines/physx34/PhysX3",
    "overlays": [
      {
        "source": "src/physx34/bench",
        "target": "Engine/Source/ThirdParty/PhysX3"
      },
      {
        "source": "src/physx34/cases",
        "target": "cases"
      }
    ]
  },
  "build": {
    "route": "physx34_clangcl_sdk_release",
    "preparation_manifest": "src/physx34/source-preparation.json",
    "source_subdir": "Engine/Source/ThirdParty/PhysX3",
    "generated_source_path": ".generated/engines/physx34/PhysX3",
    "sdk_build_dir_windows": ".build/physx34/sdk/windows-clangcl-release",
    "sdk_bin_dir_windows": ".build/physx34/sdk/windows-clangcl-release/bin",
    "sdk_lib_dir_windows": ".build/physx34/sdk/windows-clangcl-release/lib",
    "runner_source_dir": "src/physx34/bench",
    "runner_build_dir_windows": ".build/physx34/runner/windows-clangcl-release",
    "package_dir_windows": ".build/physx34/package/windows-x64-clangcl-release",
    "target": "physx34_polygon_runner",
    "cmake_build_type": "release",
    "sdk_targets": [
      "PhysX",
      "PhysXCommon",
      "PhysXCooking",
      "PhysXExtensions",
      "PxFoundation",
      "PxPvdSDK",
      "PxTask",
      "PsFastXml"
    ],
    "toolchain_id_windows": "windows_clang_cl_release",
    "executable_name_windows": "physx34_polygon_runner.exe"
  },
  "report_metadata": {
    "physics_settings": "position_iterations=5; velocity_iterations=1; sleep_threshold=0",
    "build_settings": "clang-cl 22 Release runner; Vite PhysX 3.4 runtime DLLs",
    "report_version": "3.4"
  },
  "native_settings": {
    "solver": {
      "position_iterations": {
        "native_name": "setSolverIterationCounts minPositionIters",
        "minimum": 1,
        "maximum": 255,
        "authored_default": 5
      },
      "velocity_iterations": {
        "native_name": "setSolverIterationCounts minVelocityIters",
        "minimum": 1,
        "maximum": 255,
        "authored_default": 1
      }
    },
    "sleep_enabled_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "sleep_disabled_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "continuous_collision_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "maximum_restitution": 1.0,
    "ragdoll_damping_mode": "native_coefficient",
    "continuous_collision_semantics": "discrete_swept_ccd"
  }
}
