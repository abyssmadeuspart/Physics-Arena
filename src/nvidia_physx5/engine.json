{
  "schema_version": 2,
  "engine_id": "nvidia_physx5",
  "source": {
    "type": "versioned",
    "repository_url": "https://github.com/NVIDIA-Omniverse/PhysX",
    "revision": "5.10.0.75b25f28f9",
    "reference_child": "PhysX/physx"
  },
  "prepare": {
    "prepared_path": ".generated/engines/nvidia_physx5",
    "overlays": [
      {
        "source": "src/nvidia_physx5/cases",
        "target": "cases"
      }
    ]
  },
  "build": {
    "route": "nvidia_physx5_vc17_cpu_release",
    "runner_source_dir": "src/nvidia_physx5/bench",
    "runner_build_dir_windows": ".build/nvidia_physx5/runner/windows-vc17-cpu-release",
    "package_dir_windows": "release/windows-x64/nvidia-physx-5.10",
    "target": "nvidia_physx5_polygon_runner",
    "cmake_build_type": "Release",
    "toolchain_id_windows": "nvidia_physx5_vc17_cpu_release",
    "preset": "vc17win64-cpu-only",
    "preset_file": "buildtools/presets/public/vc17win64-cpu-only.xml",
    "generated_solution": "compiler/vc17win64-cpu-only/PhysXSDK.sln",
    "install_dir": "install/vc17win64-cpu-only/PhysX",
    "executable_names": [
      "nvidia_physx5_polygon_runner.exe"
    ],
    "executable_name_windows": "nvidia_physx5_polygon_runner.exe"
  },
  "report_metadata": {
    "physics_settings": "position_iterations=5; velocity_iterations=1; sleep_threshold=0",
    "build_settings": "NVIDIA PhysX 5.10 CPU SDK: Visual Studio 2022 MSBuild Release /MD; runner: Visual Studio 2026 MSVC Release /MD",
    "report_version": "5.10.0"
  },
  "native_settings": {
    "solver": {
      "position_iterations": {
        "native_name": "setSolverIterationCounts minPositionIters",
        "minimum": 1,
        "maximum": 255,
        "authored_default": 5
      },
      "velocity_iterations": {
        "native_name": "setSolverIterationCounts minVelocityIters",
        "minimum": 0,
        "maximum": 255,
        "authored_default": 1
      }
    },
    "sleep_enabled_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "sleep_disabled_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "continuous_collision_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "maximum_restitution": 1.0,
    "ragdoll_damping_mode": "native_coefficient",
    "continuous_collision_semantics": "discrete_swept_ccd"
  }
}
