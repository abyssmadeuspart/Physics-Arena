{
  "schema_version": 2,
  "engine_id": "box3d",
  "source": {
    "type": "git",
    "repository_url": "https://github.com/erincatto/box3d",
    "revision": "9e5a4cde862fba95ff19f096b79567f3ea6c01fd",
    "reference_child": "box3d"
  },
  "prepare": {
    "prepared_path": ".generated/engines/box3d",
    "overlays": [
      {
        "source": "src/box3d/bench",
        "target": "polygon_bench"
      },
      {
        "source": "src/box3d/cases",
        "target": "cases"
      },
      {
        "source": "src/common",
        "target": "common"
      }
    ]
  },
  "build": {
    "route": "clang_cmake_ninja_release",
    "runner_source_dir": "src/box3d/bench",
    "source_subdir": "polygon_bench",
    "build_dir_windows": ".build/box3d/windows-clang",
    "target": "box3d_polygon_runner",
    "cmake_build_type": "Release",
    "cmake_args": [
      "-DBOX3D_BENCHMARKS=OFF",
      "-DBOX3D_SAMPLES=OFF",
      "-DBOX3D_UNIT_TESTS=OFF",
      "-DBOX3D_VALIDATE=OFF"
    ],
    "toolchain_id_windows": "windows_clang_cl_release",
    "executable_names": [
      "box3d_polygon_runner",
      "box3d_polygon_runner.exe"
    ]
  },
  "report_metadata": {
    "physics_settings": "substeps=4; sleep=disabled; continuous=disabled",
    "build_settings": "clang-cl 22 Release IPO static runner",
    "report_version": "0.1"
  },
  "native_settings": {
    "solver": {
      "substeps": {
        "native_name": "b3World_Step subStepCount",
        "minimum": 1,
        "maximum": 2147483647,
        "authored_default": 4
      }
    },
    "sleep_enabled_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "sleep_disabled_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "continuous_collision_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "maximum_restitution": 1.0,
    "ragdoll_damping_mode": "native_coefficient",
    "continuous_collision_semantics": "native_toggle"
  }
}
