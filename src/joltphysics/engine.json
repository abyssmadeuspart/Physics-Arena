{
  "schema_version": 2,
  "engine_id": "joltphysics",
  "source": {
    "type": "git",
    "repository_url": "https://github.com/jrouwe/joltphysics",
    "revision": "82b24442917ba8d9ced3582c2f2d8a49f4c969f6",
    "reference_child": "joltphysics"
  },
  "prepare": {
    "prepared_path": ".generated/engines/joltphysics",
    "overlays": [
      {
        "source": "src/joltphysics/bench",
        "target": "polygon_bench"
      },
      {
        "source": "src/joltphysics/cases",
        "target": "cases"
      },
      {
        "source": "src/common",
        "target": "common"
      }
    ]
  },
  "build": {
    "route": "clang_cmake_ninja_distribution",
    "runner_source_dir": "src/joltphysics/bench",
    "source_subdir": "polygon_bench",
    "build_dir_windows": ".build/joltphysics/windows-clang",
    "target": "jolt_polygon_runner",
    "cmake_build_type": "Distribution",
    "cmake_args": [
      "-DTARGET_UNIT_TESTS=OFF",
      "-DTARGET_HELLO_WORLD=OFF",
      "-DTARGET_PERFORMANCE_TEST=OFF",
      "-DTARGET_SAMPLES=OFF",
      "-DTARGET_VIEWER=OFF",
      "-DGENERATE_DEBUG_SYMBOLS=OFF",
      "-DENABLE_ALL_WARNINGS=OFF"
    ],
    "toolchain_id_windows": "windows_clang_cl_distribution",
    "executable_names": [
      "jolt_polygon_runner",
      "jolt_polygon_runner.exe"
    ]
  },
  "report_metadata": {
    "physics_settings": "solver=4 velocity,1 position; sleep=disabled",
    "build_settings": "clang-cl 22 Distribution static runner",
    "report_version": "5.6.1"
  },
  "native_settings": {
    "solver": {
      "velocity_iterations": {
        "native_name": "mNumVelocitySteps",
        "minimum": 0,
        "maximum": 255,
        "authored_default": 4
      },
      "position_iterations": {
        "native_name": "mNumPositionSteps",
        "minimum": 0,
        "maximum": 255,
        "authored_default": 1
      },
      "collision_steps": {
        "native_name": "PhysicsSystem::Update inCollisionSteps",
        "minimum": 1,
        "maximum": 2147483647,
        "authored_default": 1
      }
    },
    "sleep_enabled_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "sleep_disabled_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "continuous_collision_fixtures": [
      "open_container_falling_pile",
      "box_contact_islands",
      "ragdoll_stair_tumble",
      "large_pyramid",
      "pyramid_wall"
    ],
    "maximum_restitution": 1.0,
    "ragdoll_damping_mode": "native_coefficient",
    "continuous_collision_semantics": "discrete_linear_cast"
  }
}
